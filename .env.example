POSTGRES_USER=analytics
POSTGRES_DB=analytics
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_MAX_OUTPUT_TOKENS=512
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_BACKOFF_SECONDS=1

# Explicit generation sampling; server-owned, not a /chat parameter.
LLM_TEMPERATURE=0.2

# Internal Phase 4 tool orchestration. No public route uses this flag.
TOOL_CALLING_ENABLED=false

# Internal Phase 5 planning. Both flags remain false until explicit local evaluation.
MULTI_STEP_PLANNING_ENABLED=false
LLM_PLANNER_ENABLED=false
# Separate operator guard for a future paid frozen-suite run.
LLM_PLANNER_LIVE_REGRESSION_ENABLED=false
# Test-isolated durable Planner composition; no public route uses this flag.
DURABLE_LLM_PLANNER_ENABLED=false
# Internal timed-heartbeat worker; no public route uses this flag.
DURABLE_WORKER_RUNTIME_ENABLED=false
# End-to-end durable agent composition; no public route uses this flag.
DURABLE_AGENT_RUNTIME_ENABLED=false

# Separate internal Agent HTTP surface. It is not included in the normal API app.
INTERNAL_AGENT_API_ENABLED=false
INTERNAL_AGENT_API_KEY=
# Disposable localhost-only Fake Planner service. Never enable in a shared environment.
INTERNAL_AGENT_LOCAL_SERVICE_ENABLED=false
# PostgreSQL execution queue and independent Worker. Not part of Compose.
PERSISTENT_AGENT_QUEUE_ENABLED=false
AGENT_WORKER_SUPERVISOR_ENABLED=false
AGENT_WORKER_MAX_CONCURRENCY=2
AGENT_QUEUE_CAPACITY=100
AGENT_WORKER_POLL_INTERVAL_MS=100
AGENT_WORKER_SHUTDOWN_GRACE_SECONDS=5
# Local Agent product slice. Requires every Agent/Planner/queue guard above.
LOCAL_AGENT_PRODUCT_ENABLED=false
LOCAL_AGENT_PLANNER_MAX_CALLS=10
LOCAL_AGENT_PLANNER_BUDGET_USD=0.02
LOCAL_AGENT_PLANNER_CALL_RESERVE_USD=0.002
WORKSPACE_AGENT_BRIDGE_ENABLED=false

# Separate localhost-only real session foundation. It is never mounted by the
# normal API or Workspace bridge. Generate a unique secret for local acceptance;
# leave blank while disabled. Production requires HTTPS + Secure cookies.
LOCAL_AUTH_ENABLED=false
LOCAL_AUTH_DEPLOYMENT_MODE=local
LOCAL_AUTH_ALLOWED_ORIGIN=http://127.0.0.1:8775
LOCAL_AUTH_COOKIE_SECURE=false
LOCAL_AUTH_RATE_LIMIT_SECRET=
LOCAL_AUTH_SESSION_TTL_SECONDS=3600
LOCAL_AUTH_FAILED_LOGIN_LIMIT=5
LOCAL_AUTH_FAILED_LOGIN_WINDOW_SECONDS=300
LOCAL_AUTH_LOGIN_BLOCK_SECONDS=300

# Independent document embedding provider; never used by /chat.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Trusted-local synthetic Dataset lifecycle maintenance. No public route uses this flag.
PRIVATE_DATASET_LIFECYCLE_ENABLED=false
PRIVATE_DATASET_STORAGE_ROOT=
