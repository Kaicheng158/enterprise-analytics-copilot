POSTGRES_USER=analytics
POSTGRES_DB=analytics
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_MAX_OUTPUT_TOKENS=512
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_BACKOFF_SECONDS=1

# Explicit generation sampling; server-owned, not a /chat parameter.
LLM_TEMPERATURE=0.2

# Internal Phase 4 tool orchestration. No public route uses this flag.
TOOL_CALLING_ENABLED=false

# Internal Phase 5 planning. Both flags remain false until explicit local evaluation.
MULTI_STEP_PLANNING_ENABLED=false
LLM_PLANNER_ENABLED=false
# Separate operator guard for a future paid frozen-suite run.
LLM_PLANNER_LIVE_REGRESSION_ENABLED=false
# Test-isolated durable Planner composition; no public route uses this flag.
DURABLE_LLM_PLANNER_ENABLED=false
# Internal timed-heartbeat worker; no public route uses this flag.
DURABLE_WORKER_RUNTIME_ENABLED=false
# End-to-end durable agent composition; no public route uses this flag.
DURABLE_AGENT_RUNTIME_ENABLED=false

# Separate internal Agent HTTP surface. It is not included in the normal API app.
INTERNAL_AGENT_API_ENABLED=false
INTERNAL_AGENT_API_KEY=
# Disposable localhost-only Fake Planner service. Never enable in a shared environment.
INTERNAL_AGENT_LOCAL_SERVICE_ENABLED=false

# Independent document embedding provider; never used by /chat.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
